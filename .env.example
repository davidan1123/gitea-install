# Copy to .env and fill in. .env is ignored by git — never commit it.

# Synology NAS IP (NFS server and PostgreSQL host)
NAS_IP=192.168.1.10

# NFS export folder on the Synology (needs a "data" subfolder)
NFS_PATH=/volume1/docker/gitea

# PostgreSQL on the Synology
DB_USER=gitea
# Plain password (NOT URL-encoded). If it contains # or spaces, wrap it in
# single quotes: DB_PASSWORD='my#pass word'. Avoid $ (compose interpolation).
DB_PASSWORD=change-me
# Host port the Postgres container is published on (5432 by default)
DB_PORT=5432
DB_NAME=gitea

# How users reach Gitea (the VM's IP or a DNS name pointing at it)
GITEA_DOMAIN=192.168.1.20
GITEA_ROOT_URL=http://192.168.1.20:3000/
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

TZ=America/New_York
PUID=1000
PGID=1000
